{
  "name": "toskar",
  "displayName": "Toskar",
  "description": "Your local AI in VS Code: the models on your Toskar computer in Copilot Chat's model picker, and @toskar, Toskar's assistant, for questions about your code.",
  "version": "0.4.0",
  "publisher": "YeixioLLC",
  "license": "Apache-2.0",
  "icon": "images/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/yeixio/toskar-vscode"
  },
  "homepage": "https://toskar.ai",
  "bugs": {
    "url": "https://github.com/yeixio/toskar-vscode/issues"
  },
  "engines": {
    "vscode": "^1.104.0"
  },
  "categories": [
    "AI",
    "Chat"
  ],
  "keywords": [
    "local model",
    "local llm",
    "llama.cpp",
    "copilot",
    "private ai",
    "toskar"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "languageModelChatProviders": [
      {
        "vendor": "toskar",
        "displayName": "Toskar",
        "managementCommand": "toskar.manage"
      }
    ],
    "commands": [
      {
        "command": "toskar.askAboutThis",
        "title": "Ask Toskar about This"
      },
      {
        "command": "toskar.manage",
        "title": "Manage",
        "category": "Toskar"
      },
      {
        "command": "toskar.connect",
        "title": "Connect to Another Computer",
        "category": "Toskar"
      },
      {
        "command": "toskar.setApiKey",
        "title": "Use an API Key Instead",
        "category": "Toskar"
      },
      {
        "command": "toskar.openModels",
        "title": "Open Models",
        "category": "Toskar"
      },
      {
        "command": "toskar.refresh",
        "title": "Refresh Models",
        "category": "Toskar"
      }
    ],
    "configuration": {
      "title": "Toskar",
      "properties": {
        "toskar.url": {
          "type": "string",
          "default": "http://127.0.0.1:7331",
          "markdownDescription": "Where Toskar runs: this computer by default. For another computer, use **Toskar: Connect to Another Computer**, which sets this."
        },
        "toskar.statusBar": {
          "type": "boolean",
          "default": true,
          "description": "Show the model Toskar has loaded in the status bar."
        },
        "toskar.chatModel": {
          "type": "string",
          "default": "",
          "markdownDescription": "The model **@toskar** answers with: its id in Toskar, such as `qwen2.5-7b-q4`. Empty lets Toskar choose."
        },
        "toskar.profile": {
          "type": "string",
          "default": "",
          "markdownDescription": "The profile **@toskar** answers as, such as `programming`. Empty uses your default profile in Toskar."
        }
      }
    },
    "chatParticipants": [
      {
        "id": "toskar.chat",
        "name": "toskar",
        "fullName": "Toskar",
        "description": "Ask Toskar about your code, with its profiles, knowledge, and memory",
        "isSticky": true
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "toskar.askAboutThis",
          "group": "toskar@1"
        }
      ]
    }
  },
  "scripts": {
    "build": "esbuild src/extension.ts --bundle --platform=node --format=cjs --external:vscode --outfile=out/extension.js --sourcemap",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "package": "vsce package --no-dependencies",
    "vscode:prepublish": "pnpm run build",
    "test:e2e": "pnpm run build && esbuild test/e2e/suite.ts --bundle --platform=node --format=cjs --external:vscode --outfile=out/test/suite.js --sourcemap && esbuild test/e2e/run.ts --bundle --platform=node --format=cjs --external:@vscode/test-electron --outfile=out/test/run.js --sourcemap && cp test/e2e/llama-server.js out/test/ && node out/test/run.js"
  },
  "devDependencies": {
    "@types/multicast-dns": "7.2.4",
    "@types/node": "^20.19.0",
    "@types/vscode": "~1.104.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.1.0",
    "esbuild": "^0.25.10",
    "ovsx": "^1.3.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "packageManager": "pnpm@10.34.6",
  "dependencies": {
    "multicast-dns": "7.2.5",
    "undici": "6.29.0"
  }
}
